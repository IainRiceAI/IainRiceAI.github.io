---
const {
  title = "Let's discuss your AI challenge",
  text = "Whether you need strategy, delivery or both — I'd love to hear about what you're working on.",
} = Astro.props;
---
<section class="section tight">
  <div class="container">
    <div class="cta-band reveal">
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="hero-actions">
        <a class="btn" href="/contact/">Get in touch</a>
        
      </div>
    </div>
  </div>
</section>
