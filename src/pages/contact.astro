---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Contact | Professor Iain Rice">
  <PageHero eyebrow="Contact" title="Start a conversation about AI leadership, research or collaboration." lede="For industry collaboration, research partnerships, PhD/MSc supervision enquiries or executive AI leadership opportunities." />

  <section class="section"><div class="container grid-2">
    <div class="card"><h3>Email</h3><p><a href="mailto:iain.rice@bcu.ac.uk"><strong>iain.rice@bcu.ac.uk</strong></a></p></div>
    <div class="card"><h3>LinkedIn</h3><p><a href="https://www.linkedin.com/in/prof-iain-rice-phd-24a007188/" target="_blank" rel="noopener"><strong>Connect on LinkedIn</strong></a></p></div>
  </div></section>

  <section class="section"><div class="container">
    <div class="quote-card">
      <blockquote>"From our first meeting with Iain, it was clear he understood how companies and consultancy worked, and how best to interact with us."</blockquote>
      <cite>— Stuart Ewen, CEO of Mindset Associates</cite>
    </div>
  </div></section>

  <div class="container">
    <div class="cta-banner">
      <h2>Let's discuss how AI can create value for your organisation</h2>
      <p>Email is the best way to reach me — I respond to all enquiries.</p>
      <a class="btn" href="mailto:iain.rice@bcu.ac.uk">Send an email</a>
      <a class="btn secondary" href={`/images/Iain_Rice_CV_UK.pdf`}>Download CV</a>
    </div>
  </div>
</Layout>
