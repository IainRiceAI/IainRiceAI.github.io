---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Contact | Professor Iain Rice">
  <PageHero
    eyebrow="Contact"
    title="Start a conversation."
    lede="For industry collaboration, research partnerships, PhD/MSc supervision enquiries or executive AI leadership opportunities."
  />

  <section class="section">
    <div class="container">
      <div class="grid-2" style="max-width: 900px;">
        <div class="contact-card reveal">
          <span class="contact-label">Email</span>
          <a class="contact-value" href="mailto:iain.rice@bcu.ac.uk">iain.rice@bcu.ac.uk</a>
          <p>The best way to reach me — I respond to all enquiries.</p>
        </div>
        <div class="contact-card reveal">
          <span class="contact-label">LinkedIn</span>
          <a class="contact-value" href="https://www.linkedin.com/in/prof-iain-rice-phd-24a007188/" target="_blank" rel="noopener">Connect on LinkedIn</a>
          <p>For professional updates, talks and collaboration posts.</p>
        </div>
        <div class="contact-card reveal">
          <span class="contact-label">Based in</span>
          <span class="contact-value">Birmingham, UK</span>
          <p>Birmingham City University — available for engagements UK-wide and remotely.</p>
        </div>
        <div class="contact-card reveal">
          <span class="contact-label">Curriculum vitae</span>
          <a class="contact-value" href="/Iain_Rice_CV_UK.pdf" target="_blank" rel="noopener">Download CV (PDF)</a>
          <p>Full employment history, technical proficiencies and project record.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
