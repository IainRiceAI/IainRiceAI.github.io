---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Industry Collaboration | Professor Iain Rice">
  <PageHero eyebrow="Industry collaboration" title="AI consulting, governance and applied delivery for organisations." lede="I work with partners who need more than an AI demo: strategy, governance, data security, adoption, stakeholder confidence and measurable outcomes." />

  <section class="section">
    <div class="container grid-3">
      <div class="card"><h3>AI strategy</h3><p>Executive-level direction, opportunity discovery, gap analysis, AI roadmaps and delivery models aligned to corporate and regulatory requirements.</p></div>
      <div class="card"><h3>GenAI and LLMs</h3><p>LLM integration, guardrail deployment, GenAI cybersecurity, workflow design and risk-aware implementation.</p></div>
      <div class="card"><h3>Predictive analytics</h3><p>Forecasting, anomaly detection and custom dashboards for health, finance, public safety and operational decision-making.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">How to work with me</span>
      <h2>A practical, business-focused approach.</h2>
      <p class="lede">I start by understanding your organisation's real challenges — not just the technology. My background in both academia and industry means I can translate complex AI capability into practical, governable solutions that stakeholders trust.</p>
      <div class="timeline" style="margin-top: 24px;">
        <div class="timeline-item"><strong>Discovery</strong> — Understand your data, constraints, and what success looks like</div>
        <div class="timeline-item"><strong>Strategy</strong> — Identify where AI delivers real value vs. where other approaches work better</div>
        <div class="timeline-item"><strong>Delivery</strong> — Hands-on implementation with clear milestones and governance built in</div>
        <div class="timeline-item"><strong>Embedding</strong> — Ensure capability lives in your team with clear governance and documentation</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Partnership portfolio</span>
      <h2>Selected collaborations and clients</h2>
      <p class="lede">I've worked with organisations across healthcare, public safety, FinTech, education and technology.</p>
      <div class="grid-2" style="margin-top: 24px;">
        <div class="card">
          <h3>Birmingham Children's Hospital</h3>
          <p>Postdoc on the RAPID project, developing on-ward predictive analytics to identify at-risk children — providing 12 hours advanced warning of cardiac arrest.</p>
        </div>
        <div class="card">
          <h3>Thales UK</h3>
          <p>PhD project building anomaly detection algorithms for SONAR, contributing to defence intelligence and maritime security.</p>
        </div>
        <div class="card">
          <h3>Our Safer Streets</h3>
          <p>Working with a consortium and City of London Police to identify crime patterns and safe walking routes, reducing violence against women and girls (VAWG).</p>
        </div>
        <div class="card">
          <h3>Figg Wealth</h3>
          <p>Startup AI advisor developing strategies for maximising data value and predictive analytics in wealth management.</p>
        </div>
        <div class="card">
          <h3>METCloud</h3>
          <p>Leading a GenAI customer support solution delivering operational efficiencies for a cloud services provider.</p>
        </div>
        <div class="card">
          <h3>Oxford Partnership</h3>
          <p>Delivering dashboards, database analysis and GenAI tools to improve institutional decision-making.</p>
        </div>
        <div class="card">
          <h3>Limegreen</h3>
          <p>Managing data curation and creating a knowledge base using agentic AI tools for structured information management.</p>
        </div>
        <div class="card">
          <h3>BeeSwift</h3>
          <p>Developing multi-agent solutions for process automation and modernising legacy software systems.</p>
        </div>
        <div class="card">
          <h3>Rural Ibiza Startup</h3>
          <p>Tech advisor and interim CTO — developing AI strategy and delivering a booking platform for a rural technology business.</p>
        </div>
        <div class="card">
          <h3>Mindset Associates</h3>
          <p>Data visualisation consulting, helping translate complex data into actionable business intelligence.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark"><div class="container"><h2>Experience across high-stakes domains</h2><div class="tags"><span class="tag">Healthcare</span><span class="tag">Defence</span><span class="tag">FinTech</span><span class="tag">Public safety</span><span class="tag">Education</span><span class="tag">Economic development</span></div></div></section>

  <div class="container">
    <div class="cta-banner">
      <h2>Let's discuss your AI challenge</h2>
      <p>Whether you need strategy, delivery or both — I'd love to hear about what you're working on.</p>
      <a class="btn" href={`${base}/contact/`}>Get in touch</a>
    </div>
  </div>
</Layout>
