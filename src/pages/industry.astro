---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { industryProjects } from '../data/projects.js';
---
<Base title="Consultancy | Professor Iain Rice">
  <PageHero
    eyebrow="Industry collaboration"
    title="AI consulting, governance and applied delivery."
    lede="I work with partners who need more than an AI demo: strategy, governance, data security, adoption, stakeholder confidence and measurable outcomes."
  />

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Consultancy Services</span>
        <h2>Capability across the full AI lifecycle. Contact for pricing.</h2>
      </div>
      <div class="grid-3">
        <div class="card reveal">
          <span class="card-index">01</span>
          <h3>AI strategy</h3>
          <p>Executive-level direction, opportunity discovery, gap analysis, AI roadmaps and delivery models aligned to corporate and regulatory requirements.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">02</span>
          <h3>GenAI &amp; LLMs</h3>
          <p>LLM integration, guardrail deployment, GenAI cybersecurity, workflow design and risk-aware implementation.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">03</span>
          <h3>Predictive analytics</h3>
          <p>Forecasting, anomaly detection and custom dashboards for health, finance, public safety and operational decision-making.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">04</span>
          <h3>Governance &amp; ethics</h3>
          <p>GDPR-aware governance frameworks, responsible AI principles and data protection for regulated sectors.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">05</span>
          <h3>Training</h3>
          <p>Staff development planning, structured training sessions with hands-on development activities</p>
        </div>
        <div class="card reveal">
          <span class="card-index">06</span>
          <h3>Media & Speaking</h3>
          <p>Availabile for speaking engagements and media interaction; interview, special comment or live recording</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section class="section dark">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Partnership portfolio</span>
        <h2>Selected collaborations and clients.</h2>
        <p class="lede">
          Organisations across healthcare, public safety, FinTech, education and technology.
          Project artefacts and case materials are added as they become shareable.
        </p>
      </div>
      <div class="grid-3">
        {industryProjects.map((p) => <ProjectCard project={p} />)}
      </div>
      <div class="tags" style="margin-top: 44px; justify-content: center;">
        <span class="tag amber">Healthcare</span>
        <span class="tag amber">Defence</span>
        <span class="tag amber">FinTech</span>
        <span class="tag amber">Public safety</span>
        <span class="tag amber">Education</span>
        <span class="tag amber">Economic development</span>
      </div>
    </div>
  </section>

<!-- Approach -->
  <section class="section alt">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">How I work</span>
        <h2>A practical, business-focused approach.</h2>
        <p class="lede">
          I start by understanding your organisation's real challenges — not just the technology.
          My background in both academia and industry means I can translate complex AI capability
          into practical, governable solutions that stakeholders trust.
        </p>
      </div>
      <div class="timeline reveal">
        <div class="timeline-item">
          <span class="timeline-meta">Phase 01</span>
          <strong>Discover</strong>
          <p>Understand your data, constraints, and what success actually looks like.</p>
        </div>
        <div class="timeline-item">
          <span class="timeline-meta">Phase 02</span>
          <strong>Strategy</strong>
          <p>Identify where AI delivers real value — and where other approaches work better.</p>
        </div>
        <div class="timeline-item">
          <span class="timeline-meta">Phase 03</span>
          <strong>Deliver</strong>
          <p>Hands-on implementation with clear milestones and governance built in.</p>
        </div>
        <div class="timeline-item">
          <span class="timeline-meta">Phase 04</span>
          <strong>Embed</strong>
          <p>Capability stays in your team, with clear governance and documentation.</p>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Base>
