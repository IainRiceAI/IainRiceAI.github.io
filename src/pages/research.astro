---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Research | Professor Iain Rice">
  <PageHero eyebrow="Research profile" title="Applied AI research with clinical, industrial and social value." lede="My research background spans GenAI, machine learning, signal processing, cloud and software development across healthcare, defence, business and economic fields." />

  <section class="section">
    <div class="container grid-2">
      <div class="card"><h3>Healthcare AI</h3><p>Diabetes outcome prediction, medical image analysis for dementia characterisation, EEG analysis for intraoperative neurological monitoring and pre-eclampsia outcome prediction.</p></div>
      <div class="card"><h3>Immersive and simulation AI</h3><p>AI-enhanced VR/AR for medical simulation and training environments where learning, safety and assessment intersect.</p></div>
      <div class="card"><h3>Responsible GenAI</h3><p>LLM guardrails, cyber security implementation, GDPR-aware governance and organisational risk management.</p></div>
      <div class="card"><h3>Inclusive AI talent</h3><p>Work supporting the transition of female, black, disabled and low-income learners into AI fields through the ELAN project.</p></div>
    </div>
  </section>

  <section class="section dark"><div class="container">
    <h2>Notable research projects</h2>
    <div class="timeline">
      <div class="timeline-item"><strong>RAPID — Birmingham Children's Hospital</strong><br/>On-ward predictive analytics to identify at-risk children, providing 12 hours advanced warning of cardiac arrest.</div>
      <div class="timeline-item"><strong>Thales UK — SONAR anomaly detection</strong><br/>PhD research building anomaly detection algorithms for defence intelligence applications.</div>
      <div class="timeline-item"><strong>Our Safer Streets — Crime pattern analysis</strong><br/>Working with City of London Police to identify crime patterns and safe walking routes to reduce violence against women and girls (VAWG).</div>
    </div>
  </div></section>

  <div class="container">
    <div class="cta-banner">
      <h2>Interested in research collaboration?</h2>
      <p>I'm always open to applied AI collaborations with clinical, industrial and social value.</p>
      <a class="btn" href="/contact/">Get in touch</a>
    </div>
  </div>
</Layout>
