---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { researchProjects } from '../data/projects.js';
---
<Base title="Research | Professor Iain Rice">
  <PageHero
    eyebrow="Research profile"
    title="Applied AI research with clinical, industrial and social value."
    lede="GenAI, machine learning, signal processing and cloud/software development across healthcare, defence, business and economic fields."
  />

  <!-- Themes -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Research themes</span>
        <h2>Where my research concentrates.</h2>
      </div>
      <div class="grid-4">
        <div class="card reveal">
          <span class="card-index">01</span>
          <h3>Healthcare AI</h3>
          <p>Real-time patient monitoring, medical image analysis for dementia characterisation, EEG analysis for intraoperative neurological monitoring and pre-eclampsia prediction.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">02</span>
          <h3>World Models</h3>
          <p>Bayesian approaches to world modelling in medical, time series and streaming data systems.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">03</span>
          <h3>Responsible GenAI</h3>
          <p>LLM guardrails, cyber security implementation, GDPR-aware governance and organisational risk management.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">04</span>
          <h3>Inclusive AI talent</h3>
          <p>Supporting the transition of female, black, disabled and low-income learners into AI fields through the ELAN project.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Notable projects -->
  <section class="section alt">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Track record</span>
        <h2>Notable research projects.</h2>
      </div>
      <div class="grid-3">
        {researchProjects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Recognition strip -->
  <section class="section dark">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Recognition</span>
        <h2>Research with public reach.</h2>
        <p class="lede" style="color: var(--muted-dark);">
          I have been interviewed for ITV News and given special comment on risks of smart-glasses for the Guardian. My postdoctoral work on the RAPID project was recorded for CBBC's Operation Ouch,
          and the underlying Smart Alarm System became the subject of a patent application.
          PhD research was communicated directly to high-ranking military personnel at
          international conferences.
        </p>
        <div class="tags" style="margin-top: 24px;">
          <span class="tag">CBBC Operation Ouch</span>
          <span class="tag">Smart Alarm patent</span>
          <span class="tag">International conferences</span>
        </div>
      </div>
      <div class="split-media reveal">
        <img src="/images/iain-award.jpg" alt="Professor Iain Rice receiving recognition for his work" loading="lazy" width="auto" height = "100%"/>
        <div class="split-media-caption">Applied AI with clinical, industrial and social value.</div>
      </div>
    </div>
  </section>

  <CTA
    title="Interested in research collaboration?"
    text="I'm always open to applied AI collaborations with clinical, industrial and social value."
  />
</Base>
