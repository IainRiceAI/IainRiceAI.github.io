---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Quote from '../components/Quote.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Leadership | Professor Iain Rice">
  <PageHero
    eyebrow="Leadership"
    title="Academic, organisational and AI transformation leadership."
    lede="A track record of leading people, projects and AI systems in complex, regulated and diverse environments."
  />

  <!-- Current roles -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Current</span>
        <h2>Where I lead today.</h2>
      </div>
      <div class="grid-2">
        <div class="card reveal">
          <span class="card-index">Birmingham City University</span>
          <h3>Professor of Industrial AI · Head of Teaching &amp; Learning</h3>
          <p>Leading teaching and learning activity, supervising applied AI research, directing consultancy projects and leading a diverse team of over 100 academic staff and 3,000 students.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">Strategic AI leadership</span>
          <h3>£4.2m+ programme delivery & Interim CTO</h3>
          <p>Managing multi-stakeholder projects with regulatory reporting. Developed web-platform build in dynamic startup</p>
        </div>
        <div class="card reveal">
          <span class="card-index">Our Safer City</span>
          <h3>Chief Data Scientist</h3>
          <p>Working alongside City of London Police on predictive analytics and dashboards to help prevent violence against women and girls.</p>
        </div>
        <div class="card reveal">
          <span class="card-index">FinTech &amp; education innovation</span>
          <h3>AI Advisor · Head of Content</h3>
          <p>AI Advisor to Figg Wealth on strategy, LLM integration and predictive analytics. Head of Content with Bot Theory, building bite-size education in web-3.0 game environments.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact numbers -->
  <section class="section dark">
    <div class="container">
      <div class="stats" style="background: var(--line-dark); border-color: var(--line-dark); border-radius: var(--radius); overflow: hidden;">
        <div class="stat" style="background: var(--ink-2);">
          <div class="stat-value" style="color:#fff;"><span data-count="13">0</span><span class="unit">%</span></div>
          <div class="stat-label" style="color: var(--muted-dark);">YoY improvement in student pass rates via learner analytics</div>
        </div>
        <div class="stat" style="background: var(--ink-2);">
          <div class="stat-value" style="color:#fff;"><span data-count="4">0</span><span class="unit">m</span></div>
          <div class="stat-label" style="color: var(--muted-dark);">Budget line as former Head of School</div>
        </div>
        <div class="stat" style="background: var(--ink-2);">
          <div class="stat-value" style="color:#fff;"><span data-count="3000">0</span><span class="unit">+</span></div>
          <div class="stat-label" style="color: var(--muted-dark);">students across led programmes</div>
        </div>
        <div class="stat" style="background: var(--ink-2);">
          <div class="stat-value" style="color:#fff;"><span data-count="50">0</span><span class="unit">+</span></div>
          <div class="stat-label" style="color: var(--muted-dark);">apprentices from 20+ organisations</div>
        </div>
      </div>
    </div>
  </section>

  <Quote full={false} />

  <CTA
    title="Interested in a conversation?"
    text="I'd love to discuss how I can support your organisation's AI journey."
  />
</Base>
